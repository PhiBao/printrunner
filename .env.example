# ---- Alpaca (PAPER only — boot guard refuses live credentials) ----
# Get keys at https://app.alpaca.markets (Paper Trading section)
ALPACA_API_KEY_ID=pk_xxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override; never set this to https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Earnings calendar ----
# Primary: Finnhub free tier (https://finnhub.io)
FINNHUB_API_KEY=
# Fallback is yfinance (no key). Optional override for tests:
YF_OFF=

# ---- LLM providers (in fallback order; missing keys are skipped) ----
# Primary (hackathon partner, fast): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback 1: https://aimlapi.com (hackathon partner)
AIML_API_KEY=
AIML_MODEL=gpt-4o-mini
# Fallback 2: any OpenAI-compatible endpoint (e.g. Featherless)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Notifications (optional) ----
DISCORD_WEBHOOK_URL=

# ---- Behaviour ----
# Set to 1 to allow entries when no LLM provider is available (NOT recommended:
# default is fail-closed: no providers -> no new entries, exits still run).
ALLOW_NO_LLM_ENTRIES=
